# Copia este fichero a .env y rellena los valores. No subas .env al repositorio.

# --- Obligatorias (el bot termina si falta alguna) ---
# Usuario de la cuenta del bot en Twitch
BOT_USERNAME=
# Token IRC del bot (formato oauth:...)
BOT_TOKEN=
# Client ID de la aplicación de Twitch
CLIENT_ID=
# Client Secret de la aplicación de Twitch
CLIENT_SECRET=
# Canal al que se une el bot
CHANNEL=
# Clave de la API de Groq
GROQ_API_KEY=
# Token de usuario del streamer para llamadas Helix (clips, markers, bans, seguidores)
BROADCASTER_TOKEN=
# Secreto HMAC de EventSub (mínimo 10 caracteres)
EVENTSUB_SECRET=

# --- Tokens de renovación ---
# Renueva BROADCASTER_TOKEN al recibir 401 (se persiste en Supabase)
BROADCASTER_REFRESH_TOKEN=
# Renueva el token del bot (lo genera scripts/get-bot-token.js)
BOT_REFRESH_TOKEN=

# --- Almacenamiento ---
# URL del proyecto Supabase
SUPABASE_URL=
# Clave secreta (service role) de Supabase
SUPABASE_KEY=
# Almacenamiento alternativo (npoint.io) si no hay Supabase
NPOINT_BIN_ID=

# --- Servidor y despliegue ---
# Entorno: production | development
NODE_ENV=
# Puerto HTTP (por defecto 3000; Render lo inyecta)
PORT=
# Base de la URL de callback de EventSub si usas dominio propio o ngrok
PUBLIC_URL=
# URL pública inyectada por Render (self-ping y callback de EventSub)
RENDER_EXTERNAL_URL=
# Prefijo de comandos (por defecto !)
PREFIX=

# --- Integraciones ---
# Clave de RAWG para información de juegos (!juego, timers, hooks)
RAWG_API_KEY=

# --- Modelos de Groq ---
# Modelo principal (por defecto openai/gpt-oss-120b)
GROQ_MODEL=
# Modelo rápido (por defecto openai/gpt-oss-20b)
GROQ_MODEL_FAST=
# Modelo de !dios_fua (por defecto GROQ_MODEL)
GROQ_MODEL_COMPOUND=
# Modelos de reserva separados por comas (orden = prioridad). Se usan si el pedido devuelve 404/decommissioned
# o un 429 por cupo agotado (por minuto o diario). CADA MODELO TIENE SU PROPIO CUPO en Groq, así que el bot
# sigue hablando cuando uno se agota. Producción: openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
GROQ_MODEL_FALLBACKS=
# Cupo diario de tokens por modelo, solo para el % del resumen de fin de stream (por defecto 200000)
GROQ_DAILY_TOKEN_LIMIT=

# --- Límites de IA ---
# Peticiones globales a Groq por minuto (por defecto 20)
AI_MAX_RPM=
# Peticiones por minuto por usuario, según rol
AI_MAX_RPM_USER=
AI_MAX_RPM_MOD=
AI_MAX_RPM_CREATOR=
# Cooldown global de !dios_fua en ms (por defecto 10000)
QUESTION_COOLDOWN_MS=

# --- Comportamiento automático ---
# Intervalo del comentario IA del juego en ms (por defecto 1500000)
AI_TIMER_INTERVAL_MS=
# Probabilidad base (0-1) de cohost por mensaje tras el cooldown (por defecto 0.08)
COHOST_PROBABILITY=
# Mínimo entre cohosts en ms (por defecto 600000)
COHOST_COOLDOWN_MS=
# Tope de cohosts por hora (por defecto 4)
COHOST_MAX_PER_HOUR=
# Tiempo sin volver a nombrar al mismo usuario en el cohost, en ms (por defecto 900000)
COHOST_NAME_WINDOW_MS=
# Ventana en la que solo la primera provocación de cada usuario recibe réplica, en ms (por defecto 600000)
PROVOCATION_WINDOW_MS=
# Mínimo entre hooks anti-silencio en ms (por defecto 600000)
HOOK_INTERVAL_MS=
# Silencio del chat necesario antes de un hook en ms (por defecto 300000)
HOOK_SILENCE_MS=
# Duración total de la trivia en ms (por defecto 30000, mínimo 10000)
TRIVIA_DURATION_MS=
# Silencio antes de saludar a un lurker que vuelve, en ms (por defecto 900000)
LURKER_THRESHOLD_MS=
# Máximo de respuestas a menciones por usuario dentro de MENTION_WINDOW_MS (por defecto 3)
MENTION_MAX_PER_USER=
# Ventana del tope anterior en ms (por defecto 300000)
MENTION_WINDOW_MS=
